# ---------------------------------------------------------------------------
# Argon — environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# MiniMax API key. Server-side only — the browser never sees this value.
# Get it from https://platform.minimax.io  (Account -> API keys)
MINIMAX_API_KEY=

# Base URL for MiniMax's Anthropic-compatible Messages API.
# Verified from https://platform.minimax.io/docs/api-reference/text-anthropic-api
MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Model identifier. Verified model ids on that page:
#   MiniMax-M3.1-Flash-Preview, MiniMax-M3, MiniMax-M2.7, MiniMax-M2.7-highspeed,
#   MiniMax-M2.5, MiniMax-M2.5-highspeed, MiniMax-M2.1, MiniMax-M2.1-highspeed, MiniMax-M2
MINIMAX_MODEL=MiniMax-M3

# Set to `true` to run the app with no API key at all.
# The studio stays fully usable for manual editing; only the AI assistant is disabled.
# ARGON_DISABLE_AI=true

# Port for the standalone production server (`npm run serve`).
PORT=8787